[Unit]
Description=WarRoom Watcher Service
After=network.target

[Service]
User=dldnjsrk
WorkingDirectory=/home/dldnjsrk/remote-ubuntu/시장감지모델
EnvironmentFile=/home/dldnjsrk/remote-ubuntu/시장감지모델/.env
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/dldnjsrk/remote-ubuntu/시장감지모델/.venv/bin/python3 scripts/watcher.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
