HOST=0.0.0.0
PORT=8000
WEBHOOK_TOKEN=change-me-long-random
DB_PATH=./warroom.db
DISCORD_WEBHOOK_URL=
DISCORD_ENABLED=true
DISCORD_TIMEOUT_SEC=8
DISCORD_RETRY_MAX=3
TIMEZONE=Asia/Seoul
AS_OF_TZ=America/New_York
LOG_LEVEL=INFO
AUTO_REFRESH_PORTFOLIO=true
AUTO_REFRESH_MIN_INTERVAL_SEC=30
AUTO_REFRESH_DAILY=true
AUTO_REFRESH_DAILY_MIN_INTERVAL_SEC=30
AUTO_REFRESH_DAILY_INTERVAL_SEC=10800
AUTO_REFRESH_WINDOW_DAYS=7
AUTO_REFRESH_ON_WEBHOOK=true

# --- Portfolio cycle scaling (optional) ---
# When enabled, the portfolio engine scales risk assets by `risk_multiplier`
# from ./data/cycles_daily.csv (exported in the daily job).
PORTFOLIO_USE_CYCLES=false
PORTFOLIO_CYCLES_CSV_NAME=cycles_daily.csv

# --- Fear / Euphoria overlay (optional, enabled by default) ---
# Uses ./data/fear_euphoria_daily.csv (exported in the daily job).
# FEAR trigger now supports tiered defense levels (L1/L2/L3).
# - L1: base trigger
# - L2: DEFCON1 or stronger vol spike / closer-to-peak
# - L3: DEFCON1 + strong vol spike
# The portfolio engine will cap leverage + scale risk assets by the level.
PORTFOLIO_USE_FEAR_EUPHORIA=true

# Tiered leverage caps
PORTFOLIO_FEAR_L1_LEVERAGE_CAP=1.2
PORTFOLIO_FEAR_L2_LEVERAGE_CAP=1.0
PORTFOLIO_FEAR_L3_LEVERAGE_CAP=0.6

# Tiered risk multipliers applied to risk assets
PORTFOLIO_FEAR_L1_RISK_MULTIPLIER=0.85
PORTFOLIO_FEAR_L2_RISK_MULTIPLIER=0.70
PORTFOLIO_FEAR_L3_RISK_MULTIPLIER=0.50

# Legacy (kept for backward compatibility, but not used when fear_level exists)
PORTFOLIO_FEAR_LEVERAGE_CAP=1.0
PORTFOLIO_FEAR_RISK_MULTIPLIER=0.6
